<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fenêtre Windows d'Arcane Table : WebView2 (le moteur d'Edge fourni avec Windows) affiche l'interface,
       servie par le moteur Java (Forge) lancé en arrière-plan depuis le dossier « moteur ». -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 : présent d'office sur Windows 10 et 11, rien à installer. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ArcaneTable</AssemblyName>
    <RootNamespace>ArcaneTable</RootNamespace>
    <ApplicationIcon>ArcaneTable.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.0</Version>
    <Product>Arcane Table</Product>
    <Company>Arcane Table</Company>
    <Description>Arcane Table — Magic: The Gathering contre l'IA de Forge</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <!-- Assemblys de référence de .NET Framework : la compilation marche aussi hors de Windows. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ArcaneTable.ico" LogicalName="ArcaneTable.ico" />
  </ItemGroup>
</Project>
